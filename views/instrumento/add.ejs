
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastro de Instrumentos</title>
</head>
<body>

    <h1>Cadastro de Instrumentos Musicais</h1>

    <form method="post" action="/instrumento/add/ok">

        Nome:
        <input type="text" name="nome" required>
        <br><br>

        Fabricante:
        <input type="text" name="fabricante">
        <br><br>

        Preço:
        <input type="number" name="preco" step="0.01" required>
        <br><br>

        Tipo:
        <input type="text" name="tipo" required>
        <br><br>

        <button type="submit">Salvar</button>

    </form>

    <br>

    <a href="/instrumento/lst">Ver instrumentos cadastrados</a>

</body>
</html>
